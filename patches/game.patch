diff --git a/src/common/util/Filesystem.h b/src/common/util/Filesystem.h
new file mode 100644
index 0000000000000000000000000000000000000000..d7e4ab828673499b7c957580cc6b0ec63cd7e19f
--- /dev/null
+++ b/src/common/util/Filesystem.h
@@ -0,0 +1,47 @@
+#pragma once
+#ifndef NXDK
+#include <filesystem>
+namespace smw { namespace filesystem = std::filesystem; }
+#else
+#include <string>
+#include <string_view>
+#include <vector>
+#include <algorithm>
+namespace smw::filesystem {
+// Deliberately small path interface used by SMW; not a std::filesystem emulation.
+class path {
+    std::string value;
+    void normalize() { std::replace(value.begin(),value.end(), '/', '\\'); }
+public:
+    path() = default;
+    path(const char* s): value(s) { normalize(); }
+    path(std::string s): value(std::move(s)) { normalize(); }
+    path(std::string_view s): value(s) { normalize(); }
+    const char* c_str() const { return value.c_str(); }
+    std::string string() const { return value; }
+    std::string generic_string() const { return value; }
+    bool empty() const { return value.empty(); }
+    path filename() const { auto i=value.find_last_of("/\\"); return i==std::string::npos ? value : value.substr(i+1); }
+    path extension() const { auto f=filename().string(); auto i=f.rfind('.'); return i==std::string::npos || i==0 ? "" : f.substr(i); }
+    friend path operator/(const path& a, const path& b) {
+        if (a.empty()) return b;
+        if (b.empty()) return a;
+        return a.value + ((a.value.back()=='/' || a.value.back()=='\\') ? "" : "/") + b.value;
+    }
+    friend bool operator==(const path& a,const path& b) { return a.value==b.value; }
+    friend bool operator!=(const path& a,const path& b) { return !(a==b); }
+    friend bool operator<(const path& a,const path& b) { return a.value<b.value; }
+};
+class directory_entry {
+    filesystem::path name;
+    bool dir;
+public:
+    directory_entry(filesystem::path p, bool d): name(std::move(p)), dir(d) {}
+    const filesystem::path& path() const { return name; }
+    bool is_directory() const { return dir; }
+};
+std::vector<directory_entry> list_directory(const path&);
+bool exists(const path&);
+bool is_directory(const path&);
+}
+#endif
