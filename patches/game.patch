diff --git a/src/common/util/CheckedCast.h b/src/common/util/CheckedCast.h
new file mode 100644
index 0000000000000000000000000000000000000000..c0f3ebc3c3444c9ea2623c82323fdfadd6a2d952
--- /dev/null
+++ b/src/common/util/CheckedCast.h
@@ -0,0 +1,24 @@
+#pragma once
+#include <type_traits>
+// SMW uses single-inheritance hierarchies. Preserve checked pointer downcasts on
+// nxdk without requiring Microsoft's absent __RTDynamicCast runtime.
+namespace smw {
+#ifdef NXDK
+template<class T> inline char type_key;
+template<class Target, class Source> Target checked_cast(Source* source) {
+    using Type = std::remove_pointer_t<Target>;
+    return source ? static_cast<Target>(source->smwQueryType(&type_key<Type>)) : nullptr;
+}
+#else
+template<class Target, class Source> Target checked_cast(Source* source) {
+    return dynamic_cast<Target>(source);
+}
+#endif
+}
+#ifdef NXDK
+#define SMW_RTTI_ROOT(Type) public: virtual void* smwQueryType(const void* key) { return key==&smw::type_key<Type> ? this : nullptr; } private:
+#define SMW_RTTI(Type, Base) public: void* smwQueryType(const void* key) override { return key==&smw::type_key<Type> ? this : Base::smwQueryType(key); } private:
+#else
+#define SMW_RTTI_ROOT(Type)
+#define SMW_RTTI(Type, Base)
+#endif
