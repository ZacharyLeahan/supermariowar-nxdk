+void MI_InputControlContainer::RefreshDeviceList()
+{
+    miDeviceSelectField->clear();
+    miDeviceSelectField->add("Keyboard", DEVICE_KEYBOARD);
+#ifdef NXDK
+    // Retain absent saved assignments visibly, and refresh connected state
+    // whenever controls are opened after a hotplug event.
+    for (short i = 0; i < 4; ++i) {
+        const bool attached = nxdk_joystick_for_slot(i) != nullptr;
+        miDeviceSelectField->add("Controller " + std::to_string(i + 1) +
+            (attached ? "" : " (absent)"), i, false);
+    }
+#else
+    for (short i = 0; i < joystickcount; ++i)
+        miDeviceSelectField->add(SDL_JoystickNameForIndex(i), i, false);
+#endif
+}
