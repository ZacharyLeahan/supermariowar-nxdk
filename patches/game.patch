+// nxdk's Xbox backend reports ports 1..4. Configuration uses zero-based
+// physical slots; the dense SDL enumeration index must never identify a player.
+static int joystickSlotAt(int index)
+{
+    const int port = SDL_JoystickGetPlayerIndex(joysticks[index]);
+    if (port >= 1 && port <= 4) return port - 1;
+    // The SDK falls back to a device index when USB topology is unavailable.
+    // Preserve that limited fallback; stable physical ordering then is unknown.
+    return index < 4 ? index : -1;
+}
+int nxdk_joystick_slot(SDL_JoystickID instance)
+{
+    for (short i = 0; i < joystickcount; ++i)
+        if (joysticks[i] && SDL_JoystickGetAttached(joysticks[i]) &&
+            SDL_JoystickInstanceID(joysticks[i]) == instance) return joystickSlotAt(i);
+    return -1;
+}
+SDL_Joystick *nxdk_joystick_for_slot(int slot)
+{
+    if (slot < 0 || slot >= 4) return nullptr;
+    for (short i = 0; i < joystickcount; ++i)
+        if (joysticks[i] && SDL_JoystickGetAttached(joysticks[i]) && joystickSlotAt(i) == slot)
+            return joysticks[i];
+    return nullptr;
+}
