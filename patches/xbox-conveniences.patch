 #include "GameValues.h"
 #include "ResourceManager.h"
 #include "ui/MI_Image.h"
+#ifdef NXDK
+#include "Platform.h"
+#include <SDL.h>
+
+extern SDL_Surface* blitdest;
+
+static void drawControllerIndicator(int centerX, int top, bool connected)
+{
+    const Uint32 ink = SDL_MapRGB(blitdest->format, 32, 38, 43);
+    const auto fill = [centerX, top](int x, int y, int w, int h, Uint32 color) {
+        SDL_Rect rect{centerX + x, top + y, w, h};
+        SDL_FillRect(blitdest, &rect, color);
+    };
+
+    if (!connected) {
+        fill(-5, 4, 10, 4, ink);
+        fill(-4, 5, 8, 2, SDL_MapRGB(blitdest->format, 191, 195, 196));
+        return;
+    }
+
+    const Uint32 shell = SDL_MapRGB(blitdest->format, 53, 59, 62);
+    const Uint32 rim = SDL_MapRGB(blitdest->format, 166, 174, 171);
+    const Uint32 green = SDL_MapRGB(blitdest->format, 145, 234, 72);
+    // Shallow shoulders, a narrow waist and two tapered grips.
+    fill(-10, 0, 20, 10, rim);
+    fill(-12, 1, 24, 8, rim);
+    fill(-14, 3, 28, 6, rim);
+    for (int side : {-1, 1}) {
+        fill(side * 11 - 4, 5, 8, 6, rim);
+        fill(side * 12 - 3, 10, 6, 3, rim);
+        fill(side * 12 - 2, 13, 4, 2, rim);
+        fill(side * 11 - 3, 5, 6, 6, shell);
+        fill(side * 12 - 2, 10, 4, 3, shell);
+    }
+    fill(-11, 2, 22, 6, shell);
+    fill(-9, 1, 18, 8, shell);
+    // Offset sticks, low D-pad, green center jewel and ABXY diamond.
+    fill(-9, 2, 4, 3, rim);
+    fill(-8, 6, 2, 4, rim);
+    fill(-9, 7, 4, 2, rim);
+    fill(3, 7, 4, 3, rim);
+    fill(-2, 2, 4, 3, green);
+    fill(8, 1, 2, 2, SDL_MapRGB(blitdest->format, 255, 210, 57));
+    fill(5, 3, 2, 2, SDL_MapRGB(blitdest->format, 88, 160, 255));
+    fill(11, 3, 2, 2, SDL_MapRGB(blitdest->format, 255, 89, 75));
+    fill(8, 5, 2, 2, green);
+}
+#endif
 
