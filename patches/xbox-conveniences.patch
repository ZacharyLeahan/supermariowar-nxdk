+#ifdef NXDK
+bool GameplayState::updateControllerRecovery()
+{
+    for (short iPlayer = 0; iPlayer < 4; ++iPlayer) {
+        if (game_values.playercontrol[iPlayer] != 1)
+            continue;
+        const int slot = game_values.inputConfiguration[iPlayer][1].iDevice;
+        if (!nxdk_controller_connected(slot))
+            controllerRecoveryMask |= 1u << iPlayer;
+    }
+
+    if (!controllerRecoveryMask)
+        return false;
+
+    for (short iPlayer = 0; iPlayer < 4; ++iPlayer) {
+        if (!(controllerRecoveryMask & (1u << iPlayer)))
+            continue;
+        const int slot = game_values.inputConfiguration[iPlayer][1].iDevice;
+        const bool connected = nxdk_controller_connected(slot);
+        const bool confirmDown = connected &&
+            (nxdk_controller_button_down(slot, 0) || nxdk_controller_button_down(slot, 7));
+        if (connected && confirmDown && !controllerConfirmDown[iPlayer])
+            controllerRecoveryMask &= ~(1u << iPlayer);
+        controllerConfirmDown[iPlayer] = confirmDown;
+    }
+
+    if (!controllerRecoveryMask) {
+        game_values.playerInput.ResetKeys();
+        return false;
+    }
+    return true;
+}
+
+void GameplayState::drawControllerRecovery()
+{
+    rm->spr_dialog.draw(224, 176, {0, 0, 192, 128});
+    rm->menu_font_small.drawCentered(320, 193, "Controller Disconnected");
+    short line = 0;
+    for (short iPlayer = 0; iPlayer < 4; ++iPlayer) {
+        if (!(controllerRecoveryMask & (1u << iPlayer)))
+            continue;
+        const int slot = game_values.inputConfiguration[iPlayer][1].iDevice;
+        char message[32];
+        if (nxdk_controller_connected(slot))
+            std::snprintf(message, sizeof(message), "P%d: Press A or Start", iPlayer + 1);
+        else
+            std::snprintf(message, sizeof(message), "P%d: Connect Port %d", iPlayer + 1, slot + 1);
+        rm->menu_font_small.drawCentered(320, 218 + line * 15, message);
+        ++line;
+    }
+    rm->menu_font_small.drawCentered(320, 278, "Game Paused");
+}
+#endif
