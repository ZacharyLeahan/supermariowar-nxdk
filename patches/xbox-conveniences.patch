diff --git a/src/smw/menu/ExitMenu.cpp b/src/smw/menu/ExitMenu.cpp
new file mode 100644
index 0000000..547dad9
--- /dev/null
+++ b/src/smw/menu/ExitMenu.cpp
@@ -0,0 +1,90 @@
+#include "ExitMenu.h"
+
+#include "ResourceManager.h"
+#include "ui/MI_Button.h"
+#include "ui/MI_Image.h"
+#include "ui/MI_Text.h"
+
+extern CResourceManager* rm;
+
+UI_ExitMenu::UI_ExitMenu()
+    : UI_Menu()
+    , mPendingAction(MENU_CODE_NONE)
+{
+    mDashboardButton = new MI_Button(&rm->spr_selectfield, 120, 120, "Return to Dashboard", 400, TextAlign::CENTER);
+    mRestartXboxButton = new MI_Button(&rm->spr_selectfield, 120, 170, "Restart Xbox", 400, TextAlign::CENTER);
+    mPowerOffButton = new MI_Button(&rm->spr_selectfield, 120, 220, "Power Off Xbox", 400, TextAlign::CENTER);
+    mCancelButton = new MI_Button(&rm->spr_selectfield, 120, 280, "Cancel", 400, TextAlign::CENTER);
+
+    mDashboardButton->SetCode(MENU_CODE_EXIT_TO_DASHBOARD);
+    mRestartXboxButton->SetCode(MENU_CODE_EXIT_RESTART_XBOX);
+    mPowerOffButton->SetCode(MENU_CODE_EXIT_POWER_OFF_XBOX);
+    mCancelButton->SetCode(MENU_CODE_TO_MAIN_MENU);
+
+    mLeftHeaderBar = new MI_Image(&rm->menu_plain_field, 0, 0, 0, 0, 320, 32, 1, 1, 0);
+    mRightHeaderBar = new MI_Image(&rm->menu_plain_field, 320, 0, 192, 0, 320, 32, 1, 1, 0);
+    mHeaderText = new MI_HeaderText("Exit", 320, 5);
+
+    mConfirmImage = new MI_Image(&rm->spr_dialog, 224, 176, 0, 0, 192, 128, 1, 1, 0);
+    mConfirmTitle = new MI_HeaderText("Are You Sure?", 320, 195);
+    mConfirmQuestion = new MI_HeaderText("", 320, 220);
+    mConfirmYesButton = new MI_Button(&rm->spr_selectfield, 235, 250, "Yes", 80, TextAlign::CENTER);
+    mConfirmNoButton = new MI_Button(&rm->spr_selectfield, 325, 250, "No", 80, TextAlign::CENTER);
+    mConfirmYesButton->SetCode(MENU_CODE_EXIT_CONFIRM_YES);
+    mConfirmNoButton->SetCode(MENU_CODE_EXIT_CONFIRM_NO);
+
+    AddControl(mDashboardButton, mCancelButton, mRestartXboxButton, NULL, NULL);
+    AddControl(mRestartXboxButton, mDashboardButton, mPowerOffButton, NULL, NULL);
+    AddControl(mPowerOffButton, mRestartXboxButton, mCancelButton, NULL, NULL);
+    AddControl(mCancelButton, mPowerOffButton, mDashboardButton, NULL, NULL);
+
+    AddNonControl(mLeftHeaderBar);
+    AddNonControl(mRightHeaderBar);
+    AddNonControl(mHeaderText);
+    AddNonControl(mConfirmImage);
+    AddNonControl(mConfirmTitle);
+    AddNonControl(mConfirmQuestion);
+    AddControl(mConfirmYesButton, NULL, NULL, NULL, mConfirmNoButton);
+    AddControl(mConfirmNoButton, NULL, NULL, mConfirmYesButton, NULL);
+
+    setInitialFocus(mDashboardButton);
+    SetCancelCode(MENU_CODE_TO_MAIN_MENU);
+    hideConfirmation();
+}
+
+void UI_ExitMenu::showConfirmation(MenuCodeEnum action)
+{
+    mPendingAction = action;
+    const char* question = "Continue?";
+    if (action == MENU_CODE_EXIT_TO_DASHBOARD)
+        question = "Open Dashboard?";
+    else if (action == MENU_CODE_EXIT_RESTART_XBOX)
+        question = "Restart Xbox?";
+    else if (action == MENU_CODE_EXIT_POWER_OFF_XBOX)
+        question = "Power Off Xbox?";
+    mConfirmQuestion->SetText(question);
+
+    mConfirmImage->setVisible(true);
+    mConfirmTitle->setVisible(true);
+    mConfirmQuestion->setVisible(true);
+    mConfirmYesButton->setVisible(true);
+    mConfirmNoButton->setVisible(true);
+    RememberCurrent();
+    setInitialFocus(mConfirmNoButton);
+    SetCancelCode(MENU_CODE_EXIT_CONFIRM_NO);
+}
+
+void UI_ExitMenu::hideConfirmation()
+{
+    mConfirmImage->setVisible(false);
+    mConfirmTitle->setVisible(false);
+    mConfirmQuestion->setVisible(false);
+    mConfirmYesButton->setVisible(false);
+    mConfirmNoButton->setVisible(false);
+    SetCancelCode(MENU_CODE_TO_MAIN_MENU);
+    if (mPendingAction != MENU_CODE_NONE)
+        RestoreCurrent();
+    else
+        setInitialFocus(mDashboardButton);
+    mPendingAction = MENU_CODE_NONE;
+}
